# Copia este archivo como .env para cambiar la configuración local (opcional).
# .env está en .gitignore: nunca se sube al repositorio.

# Puerto del host para la bandeja web de Mailpit (siempre escucha solo en 127.0.0.1).
# Cámbialo si el 8025 ya está ocupado.
MAILPIT_PUERTO=8025

# Descomenta para levantar también el reenviador del escenario 5 con cada
# `docker compose up` (equivale a usar --profile extras).
# COMPOSE_PROFILES=extras
