; Zona de bancoseguro.test — la víctima.
; {{SERIAL}} lo pone `lab escenario` al activar; {{REGISTROS_ESCENARIO}}, `init` según el escenario.
; TTL de 5 s para que los cambios de escenario se vean al instante.
$ORIGIN bancoseguro.test.
$TTL 5

@         IN SOA  ns.bancoseguro.test. hostmaster.bancoseguro.test. (
                  {{SERIAL}} ; serial
                  5          ; refresh
                  5          ; retry
                  60         ; expire
                  5 )        ; TTL negativo

@         IN NS   ns.bancoseguro.test.
@         IN MX   10 receptor.bancoseguro.test.

ns        IN A    172.28.0.53
receptor  IN A    172.28.0.25
emisor    IN A    172.28.0.10

; --- Registros de autenticación del escenario activo ---
{{REGISTROS_ESCENARIO}}
