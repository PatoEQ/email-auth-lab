# CoreDNS: sirve las zonas .test del laboratorio.
# `init` y `lab escenario` escriben las zonas activas en el volumen zonas-render.
# `reload` revisa los archivos cada 2 s y recarga cuando cambia el serial del SOA.

bancoseguro.test {
    file /zonas/activas/db.bancoseguro.test {
        reload 2s
    }
    log
    errors
}

atacante.test {
    file /zonas/activas/db.atacante.test {
        reload 2s
    }
    log
    errors
}

bancos3guro.test {
    file /zonas/activas/db.bancos3guro.test {
        reload 2s
    }
    log
    errors
}

noenvia.test {
    file /zonas/activas/db.noenvia.test {
        reload 2s
    }
    log
    errors
}

# Cualquier otro nombre: NXDOMAIN inmediato. La red no tiene Internet,
# así que responder rápido evita esperas por timeouts.
. {
    template ANY ANY {
        rcode NXDOMAIN
    }
    errors
    # Si cambia este Corefile (por ejemplo, una zona nueva), CoreDNS lo recarga solo.
    reload 5s
}
